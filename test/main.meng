%
  Meng language tour.
  Comments start and end with a percent sign and can span multiple lines.
%

use "greetings.meng";   % functions from another file %

fnc Example(title: str)->
    show(title);
    

    set language: str = "Meng";
    set greeting: str = language;
    show(greeting);

    show("Escape: \"quotes\", backslash \\, tab:\tok");
    show("First line\nSecond line");
<-;

fnc Greet(name: str, greeting: str)->
    show(greeting);
    show(name);
<-;

show("Hello from a home-made programming language!");
show("No GC, super fast, and friendly.");   % a percent sign inside a string is just text: %
show("100% ready");

Example("=== Inside a function ===");
Greet("Meng", "Hi, my name is:");

set keep num_1: int = 1;   % keep = constant %
set keep num_2: int = 2;
show(num_1);
show(num_2);

if num_1 = 1 ->
    show("num_1 = 1");
<-;
if num_1 < num_2 ->
    show("num_1 < num_2");
<-;
if num_1 > num_2 ->
    show("num_1 > num_2 (not printed)");
<-;
if num_1 <= num_2 ->
    show("num_1 <= num_2");
<-;
if num_1 >= num_2 ->
    show("num_1 >= num_2 (not printed)");
<-;
if num_1 != num_2 ->
    show("num_1 != num_2");

    if num_2 > 0 ->
        show("nested if: num_2 > 0");
    <-;
<-;

set language: str = "Meng";
if language = "Meng" ->
    show("strings can be compared too");
<-;

fnc Compare(keep a: int = 0, keep b: int = 0)->
    if a < b ->
        show("a is less than b");
    <- else if a = b ->
        show("a equals b");
    <- else ->
        show("a is greater than b");
    <-;
<-;

fnc Welcome(name: str, greeting: str = "Hello", repeat: int = 1)->
    show(greeting);
    show(name);
    if repeat > 1 ->
        show("(repeated)");
    <-;
<-;

Compare(num_1, num_2);
Compare(5, 5);
Compare(9);
Welcome("Meng");
Welcome("Meng", "Good morning");
Welcome("Meng", "Hey", 2);

fnc Profile(name: str, age: int, height: float = 1.7, active: bool = true)->
    show(name);
    show(age);
    show(height);
    if active ->
        show("status: active");
    <- else ->
        show("status: inactive");
    <-;
<-;

set keep owner: str = "nasri";
set keep age: int = 20;
set height: float = 1.85;
set active: bool = false;

Profile(owner, age);
Profile(owner, age, height, active);

if age > 18 ->
    show("age is a constant (keep), so it can be used again");
<-;

% Ownership: passing a variable to a function or another variable moves it. %
set reuse lang: str = "Meng";   % reuse = can be moved many times %
Greet(lang, "reuse, first call:");
Greet(lang, "reuse, second call:");

set city: str = "Jakarta";
set city_ref: str <== city;   % borrow: city stays usable %
Greet(city_ref, "borrowed:");
show(city);

set country: str = "Indonesia";
country ()=> country_copy;    % copy: an independent value %
Greet(country, "original, moved into the function:");
Greet(country_copy, "copy, still usable:");

% Expressions: arithmetic, comparisons, and logic. Variables inside an %
% expression are only read, so they can be used again afterwards.      %
set keep price: int = 7;
set keep qty: int = 3;
set total: int = price * qty + 1;
show(total);
show(price / 2);           % int / int = int %
show(price / 2.0);         % any float makes the result a float %
show(price mod 2);         % remainder: the percent sign is taken by comments %
show(-(price - 10) * 2);

set big_order: bool = total > 20 and not (qty = 0);
show(big_order);
if price > 5 or qty > 10 ->
    show("worth a discount");
<-;

% Functions can return a value: add the type after the parameters. %
fnc Square(n: int): int ->
    return n * n;
<-;

fnc Describe(score: int): str ->
    if score >= 80 ->
        return "great";
    <- else if score >= 60 ->
        return "good";
    <-;
    return "keep practicing";
<-;

show(Square(4) + Square(3));
show(Describe(85));
show(Describe(10));

% Reassign: give a variable a new value. A moved variable becomes usable again. %
set countdown: int = 3;
while countdown > 0 ->
    show(countdown);
    countdown = countdown - 1;
<-;
show("liftoff");

set word: str = "first";
set taken: str = word;      % word is moved here... %
word = "second";            % ...and usable again after a new value %
show(word);
show(taken);

% Strings: join with +, convert with str(), int(), float().                %
% Every owned string is freed automatically when its block ends, and a     %
% move hands the memory over without copying it.                           %
fnc Badge(name: str, level: int): str ->
    return "[" + name + " lv." + str(level) + "]";
<-;

set reuse player: str = "Meng";
show(Badge(player, 7));
show("Score: " + str(int("40") + 2) + " / " + str(float("2.5") * 2));

set trail: str = "";
set step: int = 0;
while step < 3 ->
    trail = trail + str(step) + ">";
    step = step + 1;
<-;
show(trail + "end");
% read() reads a line of input, for example: set name: str = read("Name: "); %

% Arrays: [int], [float], [str], [bool]. They follow the same ownership %
% rules as strings and are freed automatically.                         %
fnc Total(keep items: [int]): int ->
    set sum: int = 0;
    set i: int = 0;
    while i < len(items) ->
        sum = sum + items[i];
        i = i + 1;
    <-;
    return sum;
<-;

set reuse scores: [int] = [70, 85];
push(scores, 92);
scores[0] = 75;
show(scores);
show("total " + str(Total(scores)) + " from " + str(len(scores)) + " scores");

set pets: [str] = [];
push(pets, "cat");
push(pets, "kitten");
show(pets[1] + " is item 1 of " + str(len(pets)));

show(Hello("imports"));
