{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Meng",
  "scopeName": "source.meng",
  "patterns": [
    { "include": "#comment" },
    { "include": "#string" },
    { "include": "#function-definition" },
    { "include": "#builtins" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#constants" },
    { "include": "#numbers" },
    { "include": "#operators" },
    { "include": "#function-call" },
    { "include": "#variable" }
  ],
  "repository": {
    "comment": {
      "name": "comment.block.meng",
      "begin": "%",
      "end": "%",
      "beginCaptures": { "0": { "name": "punctuation.definition.comment.meng" } },
      "endCaptures": { "0": { "name": "punctuation.definition.comment.meng" } }
    },
    "string": {
      "name": "string.quoted.double.meng",
      "begin": "\"",
      "end": "\"|$",
      "patterns": [
        { "name": "constant.character.escape.meng", "match": "\\\\[\"\\\\ntr]" },
        { "name": "invalid.illegal.escape.meng", "match": "\\\\." }
      ]
    },
    "function-definition": {
      "match": "\\b(fnc)\\s+([A-Za-z_][A-Za-z0-9_]*)",
      "captures": {
        "1": { "name": "storage.type.function.meng" },
        "2": { "name": "entity.name.function.meng" }
      }
    },
    "builtins": {
      "match": "\\b(str|int|float|read|len|push)\\s*(?=\\()",
      "captures": { "1": { "name": "support.function.builtin.meng" } }
    },
    "keywords": {
      "patterns": [
        { "name": "keyword.control.meng", "match": "\\b(if|else|while|return)\\b" },
        { "name": "keyword.other.meng", "match": "\\b(set|show|use|meow)\\b" },
        { "name": "storage.modifier.meng", "match": "\\b(keep|reuse)\\b" },
        { "name": "keyword.operator.logical.meng", "match": "\\b(and|or|not)\\b" },
        { "name": "keyword.operator.arithmetic.meng", "match": "\\bmod\\b" }
      ]
    },
    "types": {
      "name": "storage.type.meng",
      "match": "\\b(str|int|float|bool)\\b"
    },
    "constants": {
      "name": "constant.language.boolean.meng",
      "match": "\\b(true|false)\\b"
    },
    "numbers": {
      "name": "constant.numeric.meng",
      "match": "(?<![A-Za-z0-9_.])-?\\d+(\\.\\d+)?\\b"
    },
    "operators": {
      "patterns": [
        { "name": "keyword.operator.borrow.meng", "match": "<==" },
        { "name": "keyword.operator.copy.meng", "match": "\\(\\)=>" },
        { "name": "keyword.control.block.meng", "match": "<-\\s*;|<-|->" },
        { "name": "keyword.operator.comparison.meng", "match": "<=|>=|!=|=|<|>" },
        { "name": "keyword.operator.arithmetic.meng", "match": "[+\\-*/]" }
      ]
    },
    "function-call": {
      "match": "\\b([A-Za-z_][A-Za-z0-9_]*)\\s*(?=\\()",
      "captures": { "1": { "name": "entity.name.function.call.meng" } }
    },
    "variable": {
      "name": "variable.other.meng",
      "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b"
    }
  }
}
